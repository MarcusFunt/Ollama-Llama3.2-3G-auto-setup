# Ollama container image tag
OLLAMA_VERSION=latest

# Target model to preload
OLLAMA_MODEL=llama3.2:3b

# Minimum CUDA runtime version required by this setup script
MIN_CUDA_VERSION=12.0

# Bind address on the host (127.0.0.1 for local-only, 0.0.0.0 for LAN)
OLLAMA_BIND_ADDRESS=127.0.0.1

# Host port for the Ollama API
PORT=11434

# Optional host IP override shown by install.sh at the end
# HOST_IP=

# GPU reservation in compose: all, 0, or a positive integer
GPU_COUNT=all

# Optional comma-separated GPU IDs exposed to container, e.g. "0,1"
# GPU_DEVICE_IDS=
